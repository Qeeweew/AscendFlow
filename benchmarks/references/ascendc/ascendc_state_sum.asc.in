// Independent fixed-policy AscendC state recurrence, not generated from PlanIR.
#include "kernel_operator.h"
#include <cstdint>
using namespace AscendC;
constexpr int B = @B@, GROUPS = @GROUPS@;

extern "C" __global__ __vector__ void state_sum_reference(
    __gm__ uint8_t* initial, __gm__ uint8_t* input, __gm__ uint8_t* output, int64_t tiles) {
  TPipe pipe;
  TBuf<TPosition::VECCALC> stateBuf, inputBuf;
  pipe.InitBuffer(stateBuf, B * sizeof(float));
  pipe.InitBuffer(inputBuf, 2 * B * sizeof(float));
  auto state = stateBuf.Get<float>(), x = inputBuf.Get<float>();
  GlobalTensor<float> gi, gx, go;
  gi.SetGlobalBuffer((__gm__ float*)initial + int64_t(GetBlockIdx()) * B);
  gx.SetGlobalBuffer((__gm__ float*)input + int64_t(GetBlockIdx()) * tiles * B);
  go.SetGlobalBuffer((__gm__ float*)output + int64_t(GetBlockIdx()) * B);
  DataCopy(state, gi, B);
  // For positive tiles the first input-ready captures the preceding state DMA.
  if (tiles == 0) SetFlag<HardEvent::MTE2_MTE3>(event_t(0));
  for (int64_t step = 0; step < tiles + 1; ++step) {
    if (step < tiles) {
      const auto id = event_t(step % 2);
      if (step >= 2) WaitFlag<HardEvent::V_MTE2>(id);
      DataCopy(x[(step % 2) * B], gx[step * B], B);
      SetFlag<HardEvent::MTE2_V>(id);
    }
    if (step >= 1 && step - 1 < tiles) {
      const int64_t g = step - 1;
      const auto id = event_t(g % 2);
      if (g >= 1) PipeBarrier<PIPE_V>();
      WaitFlag<HardEvent::MTE2_V>(id);
      Add(state, state, x[(g % 2) * B], B);
      if (g == tiles - 1) SetFlag<HardEvent::V_MTE3>(event_t(0));
      if (g + 2 < tiles) SetFlag<HardEvent::V_MTE2>(id);
    }
  }
  if (tiles == 0) WaitFlag<HardEvent::MTE2_MTE3>(event_t(0));
  else WaitFlag<HardEvent::V_MTE3>(event_t(0));
  DataCopy(go, state, B);
  PipeBarrier<PIPE_ALL>();
}

extern "C" int launch_state_sum_reference(void* stream, void* initial, void* input, void* output, int64_t tiles) {
  if (tiles < 0 || tiles > (INT64_MAX - 64) / (int64_t(GROUPS) * B * sizeof(float))) return -1;
  state_sum_reference<<<GROUPS, nullptr, stream>>>((uint8_t*)initial, (uint8_t*)input, (uint8_t*)output, tiles);
  return 0;
}
